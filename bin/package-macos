#!/bin/bash
# Build Hype+ and assemble a native macOS application bundle (build/Hype+.app).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
"$root/bin/build"
ln -sf hype "$root/build/hype+"

app="$root/build/Hype+.app"
contents="$app/Contents"
macos="$contents/MacOS"
resources="$contents/Resources"

rm -rf "$app"
mkdir -p "$macos" "$resources"
cp "$root/build/hype" "$macos/Hype+"
cp -R "$root/themes" "$contents/themes"

cat > "$contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>Hype+</string>
  <key>CFBundleIdentifier</key>
  <string>org.hypeplus.app</string>
  <key>CFBundleName</key>
  <string>Hype+</string>
  <key>CFBundleDisplayName</key>
  <string>Hype+</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.7.1</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
EOF

echo "Packaged macOS bundle at $app"
